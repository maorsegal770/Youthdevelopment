// Editable blocks of the public birth-prep landing page.
// Everyone can read; only admins (Rachel) can create/edit/delete.
{
  "name": "LandingSection",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "title": "סוג מקטע",
      "enum": ["hero", "about", "service", "topic", "faq", "text"],
      "default": "text"
    },
    "title": { "type": "string", "title": "כותרת" },
    "body": { "type": "string", "title": "תוכן" },
    "icon": { "type": "string", "title": "אייקון" },
    "order": { "type": "number", "title": "סדר", "default": 0 }
  },
  "required": ["kind", "title"],
  "rls": {
    "read": true,
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
